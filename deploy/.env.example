# Use a DNS name pointed at your cloud server's public IP (for example, a DuckDNS subdomain).
DOMAIN=api.example.duckdns.org

# Use long, unique passwords. Generate JWT_SECRET with:
# openssl rand -base64 48
DB_USERNAME=rdp
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
JWT_SECRET=replace-with-at-least-64-random-characters

# The app creates this first administrator on its first run.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
